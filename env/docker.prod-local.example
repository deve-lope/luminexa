# Copy to repo root as .env.docker.prod (gitignored)
# Used ONLY by: docker compose up (docker-compose.yml)

DJANGO_SECRET_KEY=prod-local-change-me-before-deploy
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# Browser opens SPA on 3000 → API on host 9001
# Add LAN IP / domain to these lists if needed (see env/README.md)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=http://localhost:3000

# Docker prod-local DB — PostgreSQL (service `db` in docker-compose.yml)
POSTGRES_USER=luminexa
POSTGRES_PASSWORD=luminexa_change_me_before_deploy
POSTGRES_DB=luminexa
DATABASE_URL=postgres://luminexa:luminexa_change_me_before_deploy@db:5432/luminexa

# Legacy SQLite fallback (ignored when DATABASE_URL is set):
# SQLITE_DB_PATH=/app/data/db.sqlite3

# Celery (redis service in docker-compose.yml)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email — Mailpit catches all outgoing mail (inbox UI: http://localhost:8025)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@luminexa.local

# ── Going live: Brevo HTTPS API (recommended — no SMTP IP allowlist) ───────
# Create an API key in Brevo → SMTP & API → API keys, then set:
# BREVO_API_KEY=xkeysib-...
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# (When BREVO_API_KEY is set, Django uses anymail Brevo backend and ignores SMTP.)
#
# Legacy SMTP (needs Authorized IPs if Brevo locks them):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
#
# SendGrid (username is literally "apikey"):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxx
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
#
# Mailgun:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=postmaster@mg.yourdomain.com
# EMAIL_HOST_PASSWORD=your-mailgun-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
#
# Amazon SES (use the SMTP credentials from the SES console, not AWS keys):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-ses-smtp-username
# EMAIL_HOST_PASSWORD=your-ses-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Play Store review — customer signs in with email + this fixed OTP (no inbox).
# PLAY_STORE_DEMO_CUSTOMER_EMAIL=demo.customer@luminex-a.com
# PLAY_STORE_DEMO_CUSTOMER_OTP=246810

# Capacitor / FCM outside-app push (optional until google-services.json is set up)
# FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON=

# ── Stripe (Connect marketplace + provider subscriptions) ───────────────────
# Leave empty until configured — APIs return a clear "not configured" error.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Luminexa platform fee on customer→provider card payments (percent). Not Stripe’s fee.
# STRIPE_PLATFORM_FEE_PERCENT=0.5
# Create Prices in Stripe Dashboard for provider Pro plans:
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_TRIAL_DAYS=30
# QuickBooks Online (optional). Redirect URI must match Intuit app settings:
#   {PUBLIC_APP_URL or PUBLIC_API_URL}/api/v1/accounting/quickbooks/callback/
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT=sandbox
# QUICKBOOKS_REDIRECT_URI=
# Webhook URL: https://YOUR_API_HOST/api/v1/webhooks/stripe/
# Events: checkout.session.completed, customer.subscription.*, account.updated,
#         payment_intent.succeeded
